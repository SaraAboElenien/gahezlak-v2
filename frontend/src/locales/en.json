      "titleHighlight": "Questions",
      "subtitle": "Everything you need to know about our restaurant management platform. Can't find what you're looking for? We're here to help.",
      "questions": {
        "what": {
          "question": "What is Gahezlak and how can it help my restaurant?",
          "answer": "Gahezlak is an all-in-one SaaS platform that allows restaurants and cafés to manage their digital menus, track orders in real-time, customize branding, and streamline dine-in and delivery services—all from a centralized dashboard."
        },
        "qr": {
          "question": "How does the QR code system work?",
          "answer": "Each table or branch gets a unique QR code generated through your dashboard. Customers scan the QR code to access your menu, place orders, and even track their order status—no app download needed."
        },
        "customize": {
          "question": "Can I customize the look of my digital menu?",
          "answer": "Yes! You can fully personalize your menu with your logo, brand colors, fonts, layout, banners, and food photos to match your restaurant's identity and atmosphere."
        },
        "app": {
          "question": "Do I need to download an app to order from a Gahezlak-powered restaurant?",
          "answer": "Nope! Just scan the QR code at the table or visit the restaurant's unique link. Everything happens in your browser for a seamless, contactless experience."
        },
        "payment": {
          "question": "What payment options are available?",
          "answer": "You can pay online using credit/debit cards through Paymob, or choose cash through the cashier if you prefer."
        },
        "platforms": {
          "question": "What platforms or devices does Gahezlak work on?",
          "answer": "Gahezlak is a fully responsive web platform that works on smartphones, tablets, laptops, and desktops—no installation required."
        }
      }
    },
