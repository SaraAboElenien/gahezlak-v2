{
  "name": "gahezlak-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Repo-root tooling only (formatting + git hooks). NOT an npm workspace root: backend/ and frontend/ stay fully independent packages with their own node_modules and lockfiles.",
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:backend": "npm --prefix backend run lint",
    "lint:frontend": "npm --prefix frontend run lint",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,json,jsonc,css,scss,html,yml,yaml,md}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2"
  }
}
