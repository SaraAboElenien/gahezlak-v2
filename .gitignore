# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
build/
*.tsbuildinfo

# Environment — never commit real credentials.
# .env.development is committed on purpose: it holds only the local API URL
# and the frontend Sentry DSN. A frontend DSN is public by design — Vite
# inlines it into the shipped bundle, so it is visible to anyone loading the
# site and is not a secret. Backend secrets live in backend/.env, which is
# ignored (see backend/.gitignore) — never add one here.
.env
.env.*
!.env.development
!.env.example

# Internal engineering docs — kept on disk, deliberately not published.
# They record internal reasoning, audit findings, unfixed weaknesses and test
# credentials, none of which belong in a public repository. README.md and the
# per-package READMEs are the public documentation; .github/*.md is GitHub
# tooling (the PR template), not documentation, and stays.
/CHANGELOG.md
/CLAUDE.md
/DECISIONS.md
/DEPLOYMENT.md
/KNOWN_ISSUES.md
/PROJECT_AUDIT.md
/PROJECT_IMPLEMENTATION_INSTRUCTIONS.md
/REFACTOR_LOG.md
/SECURITY.md
/TECH_DEBT.md

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local scratch / tooling output
*.local
.todo
postman*
eslint-errors.txt
coverage/
.vercel/

# End-to-end test output and the cached mongod binary.
#
# Both are large and regenerable, and both sit at paths that are otherwise
# perfectly ordinary source directories, so neither is caught by the rules
# above. `.cache/mongodb-binaries` holds a ~77 MB mongod executable, shared by
# the local backend run (backend/vitest.config.mts), the E2E harness
# (playwright.config.ts) and CI, which caches it by that same path.
# `e2e/.artifacts` holds the HTML report plus a screenshot and a video for
# every failed test — megabytes per run.
#
# This repo has already paid for a large binary reaching a commit once: four
# JPEGs put 27 MB into the tree and the push failed with an HTTP 408 that
# looked like a network fault. Committed blobs stay in history whether or not
# a later commit removes them.
.cache/
e2e/.artifacts/
