{
  /*
   * `server/**` lives outside `src/`, so neither tsconfig.app.json
   * (include: ["src"]) nor tsconfig.node.json (include: the two vite/vitest
   * configs) covers it — it would be silently skipped by `tsc -b`. This
   * project puts it back under type-checking.
   *
   * Replaces the former tsconfig.vercel.json, which covered the Vercel Edge
   * Middleware and Vercel Functions that `server/index.ts` now does the job
   * of. The key difference: that code ran on the edge runtime with the DOM
   * lib and no Node globals, whereas this is a plain Node process — so
   * `types: ["node"]` is set and `fs`/`path`/`process` are legitimately in
   * scope. No emit: the server is run through `tsx`, so this is a pure
   * type-check pass.
   */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode — matches how tsx resolves at runtime, so extensionless
       relative imports (./lib/seo) stay valid in both. */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "types": ["node"],

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["server/**/*.ts"]
}
