# =============================================================================
# Gahezlak backend — environment variables
# =============================================================================
# Copy to `.env` and fill in real values:  cp .env.example .env
#
# Grouped by whether the app actually needs them to boot. Every var below is
# referenced somewhere in the backend source; nothing here is aspirational.
# -----------------------------------------------------------------------------


# --- Required: the app refuses to boot without these ------------------------
# Enforced by config/env-validation.ts, which throws at import time naming
# every missing var at once.

# MongoDB connection string (Atlas or local).
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/gahezlak

# Signs and verifies both access and refresh JWTs. Use a long random string.
# middlewares/auth.ts additionally fails fast at module load if this is unset.
JWT_SECRET=change-me-to-a-long-random-string

# The browser origin allowed through CORS (see DECISIONS.md ADR-003).
# MUST be the real deployed frontend origin in production, or every browser
# request from the live site is rejected. localhost:5173 / localhost:4173 are
# additionally allowed automatically whenever NODE_ENV is not "production".
FRONTEND_URL=http://localhost:5173


# --- Runtime ----------------------------------------------------------------

# "development" | "production". Controls CORS localhost allowances, pino
# pretty-printing, and auth cookie attributes (Secure/SameSite).
NODE_ENV=development

# Port to listen on locally. Ignored by Vercel, which supplies its own.
PORT=3000

# bcrypt cost factor. Defaults to 10 if unset (config/bcrypt.ts).
BCRYPT_SALT_ROUNDS=10


# --- Email (OTP verification + password reset) ------------------------------
# NOTE: these two are the only env vars in the project that aren't ALL_CAPS —
# utils/sendEmail.ts reads `process.env.sendEmail` / `process.env.emailPassword`
# verbatim. Renaming them is a breaking deploy change (the values also live in
# Vercel's dashboard), so it's tracked in TECH_DEBT.md rather than done
# silently. Keep the exact casing below or email will break.
sendEmail=your-smtp-user@example.com
emailPassword=your-smtp-app-password


# --- Image hosting ----------------------------------------------------------
# Required in practice for shop creation, not just logo uploads:
# createShopHandler unconditionally generates and uploads a QR code, so shop
# creation returns 500 without a real key.
IMGBB_KEY=


# --- Paymob (payments + subscriptions) --------------------------------------
# See CLAUDE.md for current status. All test integration IDs were issued by
# Paymob support on 2026-08-05; going live additionally requires Risk Approval
# for MOTO, arranged through an assigned Account Manager.
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=

# Card / 3DS. Used for one-off order checkout and for the first transaction of
# a subscription that has no free trial.
PAYMOB_DEFAULT_INTEGRATION_ID=

# Mobile wallets (Vodafone Cash / Orange Money / Etisalat). Added to
# `payment_methods` on the intention; no separate flow.
PAYMOB_WALLET_INTEGRATION_ID=

# MOTO. Used ONLY as the `integration` on the subscription *plan* — Paymob
# runs the automatic recurring deductions through it. The customer never sees
# it and we never send a Pay request against it. No plan can be created
# without this.
PAYMOB_MOTO_INTEGRATION_ID=

# Verification / auth integration. Used for the FIRST transaction of a
# free-trial subscription: it authorises the amount and voids it
# automatically, so the customer is verified without being charged at signup.
# Without it, trial signups get billed the full plan price on day one.
PAYMOB_VERIFICATION_INTEGRATION_ID=

# Paymob's "Cash Collection" (pay at an outlet). NOT currently used by any
# code path: Paymob confirmed it isn't supported on Unified Checkout, which is
# the only checkout we use, and the app's own "Cash" option means pay in
# person and skips Paymob entirely. Kept documented so the ID isn't
# rediscovered from scratch if Unified Checkout support lands.
PAYMOB_CASH_INTEGRATION_ID=

# Server-to-server callback URLs Paymob posts payment results to. Both are
# read by utils/paymob.ts and sent as `notification_url` / `webhook_url`.
#
# IMPORTANT: these are currently unset in the working .env, which means Paymob
# receives `undefined` and never calls back — this is the real cause of the
# "paid orders stay Pending forever" issue in KNOWN_ISSUES.md. Nothing fails
# at boot when they're missing, so a production deploy can silently inherit
# the same bug. They must point at a PUBLICLY reachable URL; localhost will
# never work, because Paymob's servers do the calling.
ORDER_WEBHOOK_URL=
SUBSCRIPTION_WEBHOOK_URL=


# --- Error monitoring -------------------------------------------------------
# Optional. config/sentry.ts no-ops entirely when unset, so the app runs
# identically with or without it.
SENTRY_DSN=

# Optional. Tags events with the deploy they came from. Defaults to Vercel's
# VERCEL_GIT_COMMIT_SHA when deployed, so it only needs setting to override
# that (e.g. a semantic version) or when hosting somewhere other than Vercel.
SENTRY_RELEASE=


# --- AI features (menu OCR, enrichment, search) -----------------------------
# Anthropic API key. config/claude.ts builds its client lazily, so leaving this
# unset does not block boot — the AI routes return a clear "not configured"
# error and every other route is unaffected.
#
# NOTE: these routes are the only ones in the app that cost money per request
# on a third-party account, and /ai/menu/super-search is public by necessity
# (customers searching a menu are not logged in). The whole /ai/menu router is
# rate-limited for that reason — see middlewares/rate-limit.middleware.ts.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5.
AI_MODEL=

# Optional, defaults to 8000. Caps thinking *and* response together, so a tight
# value truncates the reply mid-JSON rather than erroring.
AI_MAX_TOKENS=
